rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mkdigitalverse@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Providers collection rules
    match /providers/{providerId} {
      // Public read allowed only if listing status is APPROVED. Owner and Admin can read draft/under review.
      allow read: if resource == null || 
                     resource.data.status == 'APPROVED' || 
                     (isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin()));

      allow create: if isSignedIn() && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      // Prevent non-admin owners from self-approving or self-verifying:
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.ownerUid == request.auth.uid && 
         request.resource.data.status == resource.data.status && 
         request.resource.data.verified == resource.data.verified &&
         request.resource.data.verificationStatus == resource.data.verificationStatus)
      );
      allow delete: if isAdmin();
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Appointments collection rules
    match /appointments/{appointmentId} {
      // Only patient, provider owner, or admin can read appointment details
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.providerOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.resource.data.providerId is string &&
                       request.resource.data.date is string &&
                       request.resource.data.time is string &&
                       request.resource.data.patientName is string;
      allow update: if isSignedIn() && (
        (resource.data.patientUid == request.auth.uid) ||
        (resource.data.providerOwnerUid == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reviews collection rules
    match /reviews/{reviewId} {
      allow read: if true; // Public can read published reviews
      allow create: if isSignedIn() && request.resource.data.providerId is string &&
                       request.resource.data.rating is number;
      // Only author patient or admin can update review
      allow update: if isSignedIn() && (
        resource.data.patientUid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Review Reports collection rules
    match /reviewReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reviewId is string &&
                       request.resource.data.reason is string;
      allow update, delete: if isAdmin();
    }

    // Provider Verifications collection rules
    match /verifications/{verificationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.requestedByUid == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.requestedByUid == request.auth.uid ||
        request.resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin(); // Only admin/governance can update verification status
      allow delete: if isAdmin();
    }

    // Audit Logs collection rules
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
